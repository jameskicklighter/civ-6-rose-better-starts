<?xml version="1.0" encoding="utf-8"?>
<Mod id="4f11627b-e207-443f-bcbc-fb419d29409a" version="1">
  <Properties>
    <Name>Rose Better Starts</Name>
    <Description>Enforces each civilization's own start bias when choosing major-civilization starts, spreads city-states evenly across the civilizations' land, then places every missing strategic resource within five tiles of each start. Also adds Rose Snowflake, a six-armed map built with six-fold symmetry for six players and spectators: identical arms, two city-states on each island between them, natural wonders in a shared hub. Deterministic, map generation only.</Description>
    <Teaser>Multiplayer-safe start-bias and strategic-resource balancing for Firaxis procedural maps, plus the Rose Snowflake six-player symmetric map.</Teaser>
    <Authors>Rose</Authors>
    <AffectsSavedGames>0</AffectsSavedGames>
    <SupportsMultiplayer>1</SupportsMultiplayer>
    <CompatibleVersions>2.0</CompatibleVersions>
  </Properties>

  <Dependencies>
    <Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="Expansion: Gathering Storm" />
  </Dependencies>

  <FrontEndActions>
    <UpdateDatabase id="RBS_MAP_CONFIGURATION">
      <Properties>
        <LoadOrder>1000</LoadOrder>
      </Properties>
      <File>Configuration/RBS_MapRedirects.sql</File>
      <File>Configuration/RBS_MapOptions.sql</File>
      <File>Configuration/RBS_Snowflake.sql</File>
    </UpdateDatabase>
    <UpdateText id="RBS_MAP_TEXT">
      <Properties>
        <LoadOrder>1000</LoadOrder>
      </Properties>
      <File>Configuration/RBS_Text.xml</File>
    </UpdateText>
  </FrontEndActions>

  <InGameActions>
    <UpdateText id="RBS_MAP_TEXT_INGAME">
      <Properties>
        <LoadOrder>1000</LoadOrder>
      </Properties>
      <File>Configuration/RBS_Text.xml</File>
    </UpdateText>
    <ImportFiles id="RBS_MAP_SCRIPTS">
      <Properties>
        <LoadOrder>1000</LoadOrder>
      </Properties>
      <File>Maps/RBS_StartNormalizer.lua</File>
      <File>Maps/RBS_StartBias.lua</File>
      <File>Maps/RBS_EqualRegions.lua</File>
      <File>Maps/RBS_LargerPangaea.lua</File>
      <File>Maps/RBS_Continents.lua</File>
      <File>Maps/RBS_Fractal.lua</File>
      <File>Maps/RBS_InlandSea.lua</File>
      <File>Maps/RBS_Island_Plates.lua</File>
      <File>Maps/RBS_Lakes.lua</File>
      <File>Maps/RBS_Pangaea.lua</File>
      <File>Maps/RBS_Seven_Seas.lua</File>
      <File>Maps/RBS_Shuffle.lua</File>
      <File>Maps/RBS_Small_Continents.lua</File>
      <File>Maps/RBS_Terra.lua</File>
      <File>Maps/RBS_Archipelago_XP2.lua</File>
      <File>Maps/RBS_Continents_Islands.lua</File>
      <File>Maps/RBS_Primordial.lua</File>
      <File>Maps/RBS_Splintered_Fractal.lua</File>
      <File>Maps/RBS_Tilted_Axis.lua</File>
      <File>Maps/RBS_Highlands_XP2.lua</File>
      <File>Maps/RBS_Wetlands_XP2.lua</File>
      <File>Maps/RBS_Snowflake.lua</File>
    </ImportFiles>
  </InGameActions>

  <Files>
    <File>Configuration/RBS_MapRedirects.sql</File>
